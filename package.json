{
  "name": "@mxdhavgautam/deptrace",
  "version": "0.1.0",
  "description": "Explain where a JavaScript or TypeScript dependency is used.",
  "type": "module",
  "bin": {
    "deptrace": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/parser": "^7.28.5",
    "commander": "^14.0.2",
    "fast-glob": "^3.3.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "keywords": [
    "dependencies",
    "dependency-analysis",
    "cli",
    "typescript",
    "javascript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mxdhavgautam/deptrace.git"
  },
  "bugs": {
    "url": "https://github.com/mxdhavgautam/deptrace/issues"
  },
  "homepage": "https://github.com/mxdhavgautam/deptrace#readme"
}
